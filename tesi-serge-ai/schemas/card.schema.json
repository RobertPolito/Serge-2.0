{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"SergeRiskCard",
  "type":"object",
  "required":["id","name","description","category","probability","impact","prevention","contingency","severity"],
  "properties":{
    "id":{"type":"string"},
    "name":{"type":"string","minLength":3},
    "description":{"type":"string","minLength":10},
    "category":{"type":"string","enum":["requirements","process","technology","organizational","external","security","people"]},
    "probability":{"type":"integer","minimum":1,"maximum":5},
    "impact":{"type":"integer","minimum":1,"maximum":5},
    "prevention":{"type":"string","minLength":5},
    "contingency":{"type":"string","minLength":5},
    "severity":{"type":"string","enum":["Low","Medium","High"]}
  },
  "additionalProperties":false
}
